# ========================================================
# AI Stock & Portfolio Analysis Assistant Configuration
# ========================================================

# --------------------------------------------------------
# OPTION 1: Thesys C1 Cloud
# --------------------------------------------------------
LLM_PROVIDER=thesys
OPENAI_BASE_URL=https://api.thesys.dev/v1/embed
OPENAI_API_KEY=your_thesys_api_key_here

# Verified Thesys C1 Embed Models:
# - c1/openai/gpt-5/v-20250930          (Recommended - featured in the video)
# - c1/google/gemini-3-pro/v-20251230   (Google Gemini 3 Pro)
# - c1/google/gemini-3-flash/v-20251230 (Google Gemini 3 Flash)
# - c1-20250416                         (Thesys C1 Base)
MODEL_NAME=c1/openai/gpt-5/v-20250930

# --------------------------------------------------------
# OPTION 2: Local Ollama (Uncomment below and comment above to switch)
# --------------------------------------------------------
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_NAME=qwen3.8:27b-iq3xxs

# --------------------------------------------------------
# Server & CORS Configuration
# --------------------------------------------------------
HOST=0.0.0.0
PORT=8888
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
